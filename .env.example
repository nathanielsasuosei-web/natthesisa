# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill it in.  `.env.local` is git-ignored.
# ---------------------------------------------------------------------------

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL unset and the app runs on an embedded PostgreSQL (PGlite)
# stored in `.data/pg`. That is the right choice for local development and the
# preview sandbox — no server to install, and accounts really persist.
#
# For production, point this at a hosted Postgres (Supabase, Neon, RDS, ...).
# Use the *pooled* connection string if your host offers one (Supabase: the
# "Transaction pooler" URI, port 6543) because serverless functions open a new
# connection per invocation. Paste `db/schema.sql` into the host's SQL editor
# first, or let the app create the tables on first request.
#
# DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# Required only if you must run the embedded database in a production build.
# ALLOW_EMBEDDED_DB=1

# Overrides the embedded data directory (default `.data/pg`).
# PGLITE_DIR=.data/pg

# --- Supabase -----------------------------------------------------------------
# Optional. The app talks to PostgreSQL directly (DATABASE_URL above), so these
# are only needed for Supabase features beyond the database - file storage for
# lesson uploads, for example. Find them in the Supabase dashboard under
# Project settings → API keys, and the URL under Project settings → Data API.
#
# The publishable key is meant to be public: it ships to browsers and row level
# security is what protects the data.
# NEXT_PUBLIC_SUPABASE_URL=https://abcdefghijklmnop.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
#
# The secret key bypasses row level security. Server-side only: never prefix it
# with NEXT_PUBLIC_, and never commit it.
# SUPABASE_SECRET_KEY=sb_secret_xxx
#
# Check the pairing with `npm run supabase:check`.

# --- Sessions --------------------------------------------------------------
# Signs the session cookie. Must be at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Unset in development, the app generates `.data/session-secret` once — set
# this in production, otherwise restarting with a fresh filesystem would sign
# everyone out.
SESSION_SECRET=

# --- Owner account ---------------------------------------------------------
# The site owner is the only admin. On the first request against an empty
# database these are used to create that one account; afterwards the password
# in the database wins, so you can change it from the account page and even
# delete these two variables.
#
# Leave both unset and /admin-sign-in offers a one-time "Set up the owner
# account" form on an empty database instead (useful locally). Set them for a
# deployment: the setup route refuses to run while they are configured.
OWNER_EMAIL=admin@example.com
OWNER_PASSWORD=

# Display name for the owner, used in the console and the lesson byline.
# Defaults to the part of OWNER_EMAIL before the @ (so "admin@..." becomes
# "Admin"), which is rarely the name you want learners to see. Set it and it is
# kept in step with the account; leave it unset to manage the name from the
# account page instead.
OWNER_NAME=
